# Local development only. Deployed apps get all of this injected by the platform
# (see app.yaml `valueFrom:` + databricks.yml resources). NEVER commit a filled-in .env.

DATABRICKS_HOST=https://...
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=caltrans-whatif

# ── Analytics (M1 map) ──
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id

# ── AI Congestion Advisor ──
# Any `llm/v1/chat` Model Serving endpoint. Deployed, this comes from
# `valueFrom: serving-endpoint`; the app never hardcodes a model name.
DATABRICKS_SERVING_ENDPOINT_NAME=databricks-claude-sonnet-5

# ── Lakebase (chat persistence) ──
# Deployed, PGHOST/PGPORT/PGDATABASE/PGUSER/PGSSLMODE are auto-injected when the
# `postgres` resource is attached and only LAKEBASE_ENDPOINT is set explicitly. Locally
# you must set them all.
#
# Use the DIRECT endpoint host. The `-pooler` host rejects Lakebase OAuth tokens with
# `SASL authentication failed`.
#
# No password here: the lakebase() plugin mints short-lived (~1h) OAuth tokens and
# refreshes them. Never put a workspace PAT in PGPASSWORD.
PGHOST=ep-xxxx.database.us-east-1.cloud.databricks.com
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=you@example.com
PGSSLMODE=require
LAKEBASE_ENDPOINT=projects/<project>/branches/<branch>/endpoints/<endpoint>

# Identity used for advisor sessions when running locally. Deployed, the user comes from
# the `x-forwarded-email` header the Apps proxy injects.
ADVISOR_DEV_USER=you@example.com
